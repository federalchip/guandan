{
  "profile_id": "gd-v1-level2",
  "level_rank": 2,
  "description": "掼蛋 v1 回合/接风/结算人工预期用例（S01-S14）。expected 由 docs/rules-v1.md 第6-7节人工推导，不得由引擎输出反填。hands/trick 用符号表示（@0/@1 区分两副）；discarded 由测试取四家手牌在 108 张牌中的补集，包含所有已打出的实体牌；当前 trick 中的牌是 discarded 的子集，不额外计数。座位队伍：team0={0,2}，team1={1,3}；winner_team 为头游所属队索引。version 初值由 setup 给出，每个合法 PLAY/PASS 使其 +1，被拒动作不变。",
  "invariants": [
    {"id": "I1", "statement": "任意合法步骤或终态，四家手牌与 discarded 互不重叠，合起来恰为 108 个不同 CardId；当前 trick 牌均属于 discarded，不额外计数", "applies_to": "all"},
    {"id": "I2", "statement": "非法/被拒动作不改变 hands、discarded、trick、finish_order、phase、version", "applies_to": "reject"},
    {"id": "I3", "statement": "非终态当前玩家仍持牌；已出完玩家在轮转中被跳过", "applies_to": "all"},
    {"id": "I4", "statement": "终态仍持牌者的牌保留在手中，不暴露隐藏牌；phase=FINISHED 时 current_player=null", "applies_to": "settlement"}
  ],
